extends SceneTree
const BOSS = preload("res://scripts/arena_boss_v279.gd")
const ARENA = preload("res://scripts/arena_controller_v279.gd")
const ROOM = preload("res://scenes/rooms/colosseum.tscn")
const TOWN = preload("res://scenes/rooms/lanternhaven.tscn")

func _initialize() -> void:
	call_deferred("_verify")

func _verify() -> void:
	var room: Node2D = ROOM.instantiate()
	root.add_child(room)
	assert(room.has_node("Gameplay/ArenaController"))
	assert(room.has_node("Gameplay/Portals/lanternhaven"))
	assert(room.has_node("SpawnPoints/From_lanternhaven"))
	assert(room.get_node("Gameplay/Challenges").get_child_count()==3)
	assert(room.get_node("PaintedRoom").texture.get_size()==Vector2(1800,1250))
	var town: Node2D = TOWN.instantiate()
	assert(town.has_node("Gameplay/Portals/colosseum"))
	assert(town.has_node("SpawnPoints/From_colosseum"))
	town.free()
	var ids: Dictionary = {}
	for id in ARENA.ORDER:
		assert(BOSS.DATA.has(id))
		assert(not ids.has(ARENA.victory_key(id)))
		ids[ARENA.victory_key(id)]=true
		assert(ARENA.victory_key(id)!=ARENA.reward_key(id))
		var reward: GhostItemData = load(str(BOSS.DATA[id]["reward"]))
		assert(reward!=null)
		var unique: GhostItemInstance = GhostItemGenerator.create(reward,279100,"unique")
		assert(not preload("res://scripts/unique_specials_v261.gd").label(unique).is_empty())
		var boss: CharacterBody2D = BOSS.new()
		boss.set("boss_id",id)
		room.add_child(boss)
		assert(boss.is_in_group("enemies"))
		assert(float(boss.get("health"))==float(BOSS.DATA[id]["hp"]))
		boss.free()
	assert(get_nodes_in_group("enemies").is_empty())
	assert(BOSS.guard_factor("iron",BOSS.SEEK,Vector2.RIGHT,Vector2.RIGHT)==0.22)
	assert(BOSS.guard_factor("iron",BOSS.SEEK,Vector2.RIGHT,Vector2.LEFT)==1.0)
	assert(BOSS.guard_factor("iron",BOSS.RECOVER,Vector2.RIGHT,Vector2.RIGHT)==1.0)
	assert(BOSS.hit_region("bell_pulse",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(200,0),false))
	assert(not BOSS.hit_region("bell_pulse",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(200,0),true))
	assert(not BOSS.hit_region("bell_pulse",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(246,0),false))
	assert(BOSS.hit_region("astral_beam",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(450,40),false))
	assert(not BOSS.hit_region("astral_beam",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(450,44),false))
	assert(BOSS.hit_region("astral_seal",Vector2.ZERO,Vector2.RIGHT,Vector2(450,0),Vector2(450,100),false))
	assert(not BOSS.hit_region("shield_sweep",Vector2.ZERO,Vector2.RIGHT,Vector2.ZERO,Vector2(-100,0),false))
	room.free()
	print("v2.79 colosseum links, boss resources, reward skills, guard and telegraph checks PASS")
	quit(0)
