extends SceneTree
const INVENTORY = preload("res://scripts/inventory.gd")
const GRID = preload("res://scripts/stash_grid_v284.gd")

func _initialize() -> void:
	call_deferred("_verify")

func _verify() -> void:
	var bag: Node = INVENTORY.new()
	var a: GhostItemInstance = GhostItemGenerator.create(preload("res://items/vesper_rapier.tres"),284001,"unique")
	var b: GhostItemInstance = GhostItemGenerator.create(preload("res://items/vesper_rapier.tres"),284002,"rare")
	bag.contents.append(a)
	bag.contents.append(b)
	bag.grid_positions.append(Vector2i(0,0))
	bag.grid_positions.append(Vector2i(5,0))
	assert(bag.place_or_swap_v284(0,0,5,0,false))
	assert(bag.get_position(0)==Vector2i(5,0))
	assert(bag.get_position(1)==Vector2i(0,0))
	assert(not bag.place_or_swap_v284(0,0,9,5,false))
	assert(bag.get_position(0)==Vector2i(5,0))
	assert(bag.transfer_grid_v284(a,true,Vector2i(0,0),false))
	assert(bag.contents.size()==1 and bag.vault.size()==1)
	assert(bag.stash_position_v284(a)==Vector2i(0,0))
	assert(bag.transfer_grid_v284(b,true,Vector2i(5,0),false))
	assert(bag.move_stash_v284(a,Vector2i(5,0),false))
	assert(bag.stash_position_v284(b)==Vector2i(0,0))
	assert(bag.stash_position_v284(a)==Vector2i(5,0))
	assert(bag.move_stash_v284(a,Vector2i(0,12),false))
	var saved: Dictionary = bag._build_save_data()
	var restored: Node = INVENTORY.new()
	assert(restored._restore_save_data(saved))
	assert(restored.vault.size()==2)
	assert(restored.stash_position_v284(restored.vault[0])==Vector2i(0,12))
	assert(restored.vault[0].cosmetic_uid==a.cosmetic_uid)
	assert(restored.transfer_grid_v284(restored.vault[0],false,Vector2i(0,0),false))
	assert(restored.contents.size()==1)
	assert(restored.contents[0].item_seed==a.item_seed)
	assert(restored.contents[0].quality==a.quality)
	bag.free()
	restored.free()
	print("v2.84 footprint swaps, stash tab persistence, transfer identity PASS")
	quit(0)
