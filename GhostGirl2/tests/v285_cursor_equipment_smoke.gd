extends SceneTree
const INVENTORY = preload("res://scripts/inventory.gd")

func _initialize() -> void:
	call_deferred("_verify")

func _verify() -> void:
	var bag: Node = INVENTORY.new()
	var a: GhostItemInstance = GhostItemGenerator.create(preload("res://items/vesper_rapier.tres"),285001,"unique")
	var b: GhostItemInstance = GhostItemGenerator.create(preload("res://items/vesper_rapier.tres"),285002,"rare")
	bag.contents.append(a)
	bag.contents.append(b)
	bag.grid_positions.append(Vector2i(0,0))
	bag.grid_positions.append(Vector2i(5,0))
	assert(bool(bag.equip_cursor_v285(0,"sword",false)["ok"]))
	assert(bag.get_equipped("sword")==a)
	var replacement: Dictionary = bag.equip_cursor_v285(1,"sword",false)
	assert(bool(replacement["ok"]) and int(replacement["next"])==0)
	assert(bag.get_equipped("sword")==b)
	assert(not bool(bag.equip_cursor_v285(0,"dress",false)["ok"]))
	assert(bag.lift_equipment_v285("sword",false)==1)
	assert(bag.get_equipped("sword")==null)
	assert(bag.transfer_grid_v284(a,true,Vector2i(0,0),false))
	assert(bag.cross_swap_v285(b,true,Vector2i(0,0),false)==a)
	assert(bag.contents[0]==a and bag.vault[0]==b)
	assert(bag.get_position(0)==Vector2i(5,0))
	assert(bag.stash_position_v284(b)==Vector2i(0,0))
	assert(bag.cross_swap_v285(b,false,Vector2i(5,0),false)==a)
	assert(bag.contents[0]==b and bag.vault[0]==a)
	assert(bag.rename_stash_v285(0,"  Unique weapons  ",false))
	assert(bag.stash_name_v285(0)=="Unique weapons")
	var restored: Node = INVENTORY.new()
	assert(restored._restore_save_data(bag._build_save_data()))
	assert(restored.stash_name_v285(0)=="Unique weapons")
	assert(restored.vault[0].cosmetic_uid==a.cosmetic_uid)
	bag.save_block_reason="test forced failure"
	assert(not bool(bag.equip_cursor_v285(0,"sword")["ok"]))
	assert(bag.get_equipped("sword")==null)
	assert(bag.cross_swap_v285(b,true,Vector2i(0,0))==null)
	assert(bag.contents[0]==b and bag.vault[0]==a)
	assert(not bag.rename_stash_v285(0,"failed"))
	assert(bag.stash_name_v285(0)=="Unique weapons")
	bag.free()
	restored.free()
	print("v2.85 cursor equip, cross-store swaps, tab persistence and rollback PASS")
	quit(0)
