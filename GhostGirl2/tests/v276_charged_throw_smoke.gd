extends SceneTree
const SPECIAL = preload("res://scripts/unique_specials_v261.gd")
const LOCK = preload("res://scripts/thrown_weapon_lock_v273.gd")
const AUDIO = preload("res://scripts/combat_juice_v194.gd")
const INNATE = preload("res://scripts/unique_innate_v274.gd")

func _initialize() -> void:
	call_deferred("_verify")

func _verify() -> void:
	assert(is_equal_approx(SPECIAL.charge_power(-1.0),0.75))
	assert(is_equal_approx(SPECIAL.charge_power(1.0),1.35))
	assert(is_equal_approx(SPECIAL.charge_power(4.0),1.35))
	assert(SPECIAL.charge_power(0.5)>SPECIAL.charge_power(0.0))
	assert(SPECIAL.SPECIALS.size()==7)
	assert(INNATE.POWERS.size()==59)
	for base in SPECIAL.SPECIALS:
		var skill: String = SPECIAL.SPECIALS[base]
		assert(SPECIAL.NAMES.has(skill))
		assert(not INNATE.POWERS.has(base))
		var definition: GhostItemData = load("res://items/"+str(base)+".tres")
		assert(definition!=null)
		var unique: GhostItemInstance = GhostItemGenerator.create(definition,276123,"unique")
		var normal: GhostItemInstance = GhostItemGenerator.create(definition,276123,"normal")
		assert(SPECIAL.kind(unique)==skill)
		assert(SPECIAL.kind(normal).is_empty())
	assert(not SPECIAL.is_throw("winter_return"))
	assert(not SPECIAL.is_throw("bellthorn_judgment"))
	assert(not SPECIAL.is_throw("reliquary_fan"))
	assert(not SPECIAL.is_throw("last_toll"))
	assert(not SPECIAL.is_throw("eclipse_dance"))
	var lock = LOCK.new()
	var a: Node = Node.new()
	var b: Node = Node.new()
	root.add_child(a)
	root.add_child(b)
	lock.register(a)
	lock.register(b)
	assert(lock.busy())
	a.queue_free()
	assert(lock.busy())
	b.queue_free()
	assert(not lock.busy())
	for cue in ["throw_charge","throw_ready","throw_release","throw_impact"]:
		var stream: AudioStreamWAV = AUDIO._render(cue)
		assert(stream.data.size()>0)
		assert(stream.mix_rate==AUDIO.RATE)
	print("v2.76 charged throw, unique coverage, projectile lifetime and audio smoke PASS")
	quit(0)
